# Copy to .env and fill in values. Never commit .env.
# Expo loads EXPO_PUBLIC_* vars at build time via app.config.ts.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_OCR_API_KEY=your-ocr-api-key
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Set to true to skip Supabase and load ~60 days of patterned seed expenses/moods.
# Restart Expo with --clear after changing this.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Local only — scripts/exportFigmaTokens.ts (never commit the token)
# Figma → Settings → Security → Personal access tokens (File content: read)
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=
