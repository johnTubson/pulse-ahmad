# Copy to .env and fill in values. Never commit .env.
# Expo loads EXPO_PUBLIC_* vars at build time via app.config.ts.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OCR: llm (default) | google | ocrspace | interfaze
EXPO_PUBLIC_OCR_PROVIDER=llm
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-api-key
# Optional; defaults to qwen/qwen3.7-flash
# EXPO_PUBLIC_OPENROUTER_MODEL=qwen/qwen3.7-flash
# Optional comma-separated vision models tried after the primary on 429 / rate limit.
# Defaults: qwen/qwen3.5-flash-02-23,google/gemma-3-4b-it,mistralai/mistral-small-3.2-24b-instruct
# EXPO_PUBLIC_OPENROUTER_FALLBACK_MODELS=
EXPO_PUBLIC_OCR_API_KEY=your-google-cloud-vision-api-key
EXPO_PUBLIC_OCR_SPACE_API_KEY=your-ocr-space-api-key
# Optional PRO / regional endpoint (defaults to https://api.ocr.space/parse/image)
# EXPO_PUBLIC_OCR_SPACE_URL=
EXPO_PUBLIC_INTERFAZE_API_KEY=your-interfaze-api-key

EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Set to true to skip Supabase and load ~60 days of patterned seed expenses/moods.
# Restart Expo with --clear after changing this.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Local only — scripts/exportFigmaTokens.ts (never commit the token)
# Figma → Settings → Security → Personal access tokens (File content: read)
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=
